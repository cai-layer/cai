<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Hardened-runtime resource-access entitlements. Cai enables the hardened
	     runtime, so in-process EventKit / Contacts access is blocked at the code-
	     signature layer WITHOUT these — the request returns false instantly, no
	     prompt, status stays notDetermined. These are NOT sandbox entitlements
	     (Cai isn't sandboxed); they're the hardened-runtime equivalent, required
	     even for a non-sandboxed app. See _docs/architecture/PERMISSIONS.md. -->
	<!-- calendars covers BOTH EventKit entity types: .event (Calendar) and
	     .reminder (Reminders). There is NO
	     com.apple.security.personal-information.reminders key — the
	     hardened-runtime Resource Access list is audio-input, camera, location,
	     addressbook, calendars, photos-library and apple-events, and nothing
	     else (verified against Xcode's capability UI and the system sandbox
	     profiles, which know only addressbook/calendars/location). The in-app
	     Reminders toggle rides this entitlement; do NOT "fix" a missing
	     Reminders prompt by inventing a reminders key. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<key>com.apple.security.personal-information.addressbook</key>
	<true/>
</dict>
</plist>
